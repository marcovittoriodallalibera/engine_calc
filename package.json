{
  "name": "phase-360-engine-calculator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop": "npm run desktop:build && electron desktop/app",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:smoke": "npm run desktop:build && electron desktop/app --smoke-test",
    "desktop:dist:win": "npm run desktop:build && electron-builder --config electron-builder.config.mjs --win nsis portable --x64 --publish never",
    "desktop:dist:win-dir": "npm run desktop:build && electron-builder --config electron-builder.config.mjs --win dir --x64 --publish never",
    "desktop:verify-fuses": "node scripts/verify-electron-fuses.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/engine/*.test.ts tests/project/*.test.ts tests/presentation/*.test.ts",
    "test:desktop": "node --test tests/desktop/*.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:desktop && npm run build && npm run test:render && npm run desktop:build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@electron/fuses": "2.1.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
